# 仅在本机保存真实密钥；.env 与 .env.local 均被 Git 忽略。
DEEPSEEK_API_KEY=your_api_key_here
# 可选：默认使用 deepseek-v4-flash。
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：DeepSeek 请求超时毫秒数，默认 45000，允许 1000–180000。
DEEPSEEK_TIMEOUT_MS=45000
# 可选：默认只监听本机；部署到容器或局域网时按需改为 0.0.0.0。
TRAVEL_AGENT_HOST=127.0.0.1
# 可选：测试或部署时覆盖 SQLite 数据库位置。
DATABASE_PATH=data/travel-agent.db
# 可选：覆盖照片文件目录。
UPLOADS_PATH=data/uploads
