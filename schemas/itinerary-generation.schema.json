{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "budgetSummary", "recommendations", "itinerary"],
  "properties": {
    "title": { "type": "string" },
    "budgetSummary": { "$ref": "#/$defs/budgetSummary" },
    "recommendations": { "$ref": "#/$defs/recommendations" },
    "itinerary": { "type": "array", "items": { "$ref": "#/$defs/day" } }
  },
  "$defs": {
    "moneyRange": {
      "type": "object", "additionalProperties": false,
      "required": ["min", "max", "currency"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "currency": { "type": "string", "enum": ["CNY", "JPY", "USD", "EUR", "GBP"] }
      }
    },
    "budgetSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["totalPerPerson", "transport", "accommodation", "food", "activities", "contingency"],
      "properties": {
        "totalPerPerson": { "$ref": "#/$defs/moneyRange" },
        "transport": { "$ref": "#/$defs/moneyRange" },
        "accommodation": { "$ref": "#/$defs/moneyRange" },
        "food": { "$ref": "#/$defs/moneyRange" },
        "activities": { "$ref": "#/$defs/moneyRange" },
        "contingency": { "$ref": "#/$defs/moneyRange" }
      }
    },
    "accommodationArea": {
      "type": "object", "additionalProperties": false,
      "required": ["city", "area", "suitableFor", "advantages", "cautions", "nightlyBudget", "recommendedNights"],
      "properties": {
        "city": { "type": "string" },
        "area": { "type": "string" },
        "suitableFor": { "type": "string" },
        "advantages": { "type": "array", "items": { "type": "string" } },
        "cautions": { "type": "array", "items": { "type": "string" } },
        "nightlyBudget": { "$ref": "#/$defs/moneyRange" },
        "recommendedNights": { "type": "integer" }
      }
    },
    "transportAdvice": {
      "type": "object", "additionalProperties": false,
      "required": ["segment", "mode", "recommendation", "notes"],
      "properties": {
        "segment": { "type": "string" },
        "mode": { "type": "string" },
        "recommendation": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendations": {
      "type": "object", "additionalProperties": false,
      "required": ["accommodationAreas", "transportation"],
      "properties": {
        "accommodationAreas": { "type": "array", "items": { "$ref": "#/$defs/accommodationArea" } },
        "transportation": { "type": "array", "items": { "$ref": "#/$defs/transportAdvice" } }
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "category", "timeSlot", "durationMinutes", "reason", "notes", "reservationRequired"],
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["transport", "accommodation", "attraction", "food", "shopping", "nature", "culture", "experience", "free_time"] },
        "timeSlot": { "type": "string", "enum": ["morning", "afternoon", "evening", "all_day"] },
        "durationMinutes": { "type": "integer" },
        "reason": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "reservationRequired": { "type": "boolean" }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false,
      "required": ["dayNumber", "city", "theme", "activities", "estimatedBudget", "walkingDistanceKm", "transitMinutes", "transportationNotes", "tip"],
      "properties": {
        "dayNumber": { "type": "integer" },
        "city": { "type": "string" },
        "theme": { "type": "string" },
        "activities": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/activity" } },
        "estimatedBudget": { "$ref": "#/$defs/moneyRange" },
        "walkingDistanceKm": { "type": "number" },
        "transitMinutes": { "type": "integer" },
        "transportationNotes": { "type": "array", "items": { "type": "string" } },
        "tip": { "type": "string" }
      }
    }
  }
}
